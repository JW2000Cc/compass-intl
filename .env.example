# LLM
# ⭐ 推荐: 用 Claude (Anthropic API)。
#    原因: Compass 的 skill 生态走 Claude Code Skill 路径——只有 Claude 用户能用。
#    其它 provider 仍可使用 Compass 核心功能（matcher / claim grounder / 简历改写），
#    但 skill 那一层（ATS 审核 / cover letter / 公司情报等）是 Claude-only。
#    详见 docs/SKILLS.md。
LLM_PROVIDER=claude          # claude | openai (其它 OpenAI 兼容也可)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6  # claude-sonnet-4-6 | claude-haiku-4-5 | gpt-4o

# App
COMPASS_PORT=7000
COMPASS_DATA_DIR=./data
COMPASS_LOG_LEVEL=INFO
COMPASS_SECRET_KEY=change-me-in-production
# IANA timezone name — used for displaying times in UI (storage is always UTC).
# Examples: Europe/Rome, Asia/Shanghai, America/New_York, UTC
COMPASS_TZ=Europe/Rome

# Reflection
DRIFT_CHECK_INTERVAL_DAYS=14
ASSUMPTIONS_REGEN_INTERVAL_DAYS=30
ADVERSARIAL_VOICE_ENABLED=true
